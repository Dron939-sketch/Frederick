# Database
DATABASE_URL=postgresql://fredi_user:password@localhost:5432/fredi_db

# Redis
REDIS_URL=redis://localhost:6379

# APIs
DEEPSEEK_API_KEY=sk-xxxxxxxxxxxxx
DEEPGRAM_API_KEY=xxxxxxxxxxxxx
YANDEX_API_KEY=xxxxxxxxxxxxx
OPENWEATHER_API_KEY=xxxxxxxxxxxxx

# Kimi (Moonshot) — запасная модель. Включается только при заданном ключе:
# DeepSeek остаётся основной моделью, Kimi отвечает, когда тот недоступен
# (кончился баланс, истёк ключ, потерян маршрут, провайдер молчит или 5xx).
# Без ключа сервис выключен и поведение Фреди не меняется.
# Модели аккаунта (проверено 06.11.2026): kimi-k3, kimi-k3.1-pro,
# kimi-k3.1-pro-highspeed. Алиаса kimi-latest у провайдера нет (404).
# MOONSHOT_API_KEY=sk-xxxxxxxxxxxxx
# MOONSHOT_BASE_URL=https://api.moonshot.ai/v1
# MOONSHOT_MODEL=kimi-k3.1-pro-highspeed
# MOONSHOT_MODELS=kimi-k3.1-pro,kimi-k3   # запасные имена на случай 404

# Панель двух моделей: DeepSeek и Kimi думают параллельно, человеку уходит один
# ответ (синтез делает DeepSeek, голос Фреди сохраняется). Требует оба ключа.
# PANEL_MODE=heavy            # heavy — режимы ниже; all — все разговорные; off — выкл
# PANEL_MODES=psychologist,coach,trainer
# PANEL_SIMILARITY=0.82       # если ответы совпали сильнее — синтез не тратится
# PANEL_SECONDARY_TOKENS=400  # бюджет второго мнения: коротко, а не второй ответ
# PANEL_SECONDARY_TIMEOUT=50  # сколько ждём второе мнение; дольше — один ответ
# MOONSHOT_FAILS_BEFORE_COOLDOWN=3   # сбоев подряд до паузы Kimi
# MOONSHOT_COOLDOWN=300              # пауза в секундах; панель в это время выключена

# LLM-провайдер (мастер-выключатель)
# По умолчанию весь Фреди работает на DeepSeek, Anthropic не вызывается нигде.
# USE_ANTHROPIC=1 включает Claude разом во всех точках: входной чат (tool-use:
# дата/погода/веб-поиск), генерация навыков-планов, reengagement-сообщения,
# mode_enhancer (психолог/коуч/тренер). Требует ANTHROPIC_API_KEY.
# Без флага ANTHROPIC_API_KEY можно не задавать вовсе.
# USE_ANTHROPIC=1
# ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxx
# ANTHROPIC_MODEL=claude-sonnet-4-6

# App
ENVIRONMENT=production
LOG_LEVEL=info
DEBUG=false

# Performance
DB_POOL_MIN_SIZE=5
DB_POOL_MAX_SIZE=20
REDIS_MAX_CONNECTIONS=20
UVICORN_WORKERS=2
UVICORN_LIMIT_CONCURRENCY=100

# Timeouts
REQUEST_TIMEOUT=30
VOICE_TIMEOUT=60
DEEPSEEK_TIMEOUT=30

# Freddy SDK
FREDDY_URL=https://agent-ynlg.onrender.com
FREDDY_USERNAME=frederick_bot
FREDDY_PASSWORD=
FREDDY_TOKEN=

# Security
SECRET_KEY=your-secret-key-here
CORS_ORIGINS=https://fredi-frontend.onrender.com,http://localhost:3000

YOOKASSA_SHOP_ID=123456
YOOKASSA_SECRET_KEY=test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxx
